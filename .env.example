# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required only when OpenAI GPT models are enabled.
# Keep this server-side. Never expose it through Vite variables or browser config.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ANTHROPIC_API_KEY: Required only when Anthropic Claude models are enabled.
# Server-side only. Never expose it through Vite variables or browser config.
# Without it, Claude models appear as "준비 중" and requests use the default model.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# LearnHub-enforced AI quotas. Provider billing/rate limits remain separate.
AI_MAX_CONCURRENT="4"
AI_REQUESTS_PER_USER_PER_MINUTE="12"
AI_REQUESTS_PER_USER_PER_DAY="100"
AI_RESERVED_OUTPUT_TOKENS_PER_USER_PER_DAY="100000"
AI_GLOBAL_REQUESTS_PER_DAY="10000"
AI_GLOBAL_RESERVED_OUTPUT_TOKENS_PER_DAY="1000000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://learnhub-1de94.web.app"

# Keep temporary deployment URLs out of search results. Change to true only
# after a permanent domain, public legal pages, and production content are ready.
SEO_INDEXABLE="false"

# Firebase browser configuration. These are public SDK values, never Admin credentials.
LEARNHUB_FB_PROJECT_ID="learnhub-1de94"
LEARNHUB_FB_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
LEARNHUB_FB_AUTH_DOMAIN="learnhub-1de94.firebaseapp.com"
LEARNHUB_FB_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
LEARNHUB_FB_MESSAGING_SENDER_ID="YOUR_FIREBASE_SENDER_ID"
LEARNHUB_FB_STORAGE_BUCKET="learnhub-1de94.firebasestorage.app"
